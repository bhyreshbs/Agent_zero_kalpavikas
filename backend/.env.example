# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Secrets (never commit real values) ----
JWT_SECRET=change_me_to_a_long_random_string
ADMIN_SECRET=change_me_admin_password

# ---- Database ----
DATABASE_FILE=./data/agentzero.sqlite

# ---- Game config (admin-overridable at runtime via /api/admin/config) ----
GAME_DURATION_SECONDS=900
MAX_RECOVERIES=3
INITIAL_LIVES=5
RECOVERY_WINDOW_SECONDS=30

# ---- Optional AI ----
# Optional AI integration for in-character agent chat (flavor/personality only —
# it can never touch lives, score, the timer, or level completion; see
# src/engine/agentEngine.js). Leave AI_API_KEY unset and the game runs entirely
# on the built-in RuleBasedFallbackAgent — no network, no cost, fully playable.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
# Optional. Supported defaults: groq, openai, openrouter, gemini.
AI_BASE_URL=
AI_JSON_MODE=true

# ---- Test / demo mode ----
# Never enable this on the public event build.
DEMO_MODE_ENABLED=true
DEMO_MODE_SECRET=change_me_demo_password
