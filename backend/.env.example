# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- InsForge (backend only — never expose to the frontend) ----
# Project base URL, e.g. https://<appkey>.<region>.insforge.app
INSFORGE_URL=https://YOUR_APPKEY.YOUR_REGION.insforge.app
# Project admin API key (full access). Get it from `npx @insforge/cli` link (.insforge/project.json). Server-only.
INSFORGE_API_KEY=your-insforge-admin-api-key

# ---- Database (InsForge PostgreSQL — DIRECT connection, max_connections = 30) ----
# From: npx @insforge/cli db connection-string   (URL-encode special characters in the password)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_APPKEY.YOUR_REGION.database.insforge.app:5432/insforge?sslmode=require
# Connections per server instance. Keep (instances x this) well under 30. Default 3.
DB_POOL_MAX=3

# ---- Admin (unchanged) ----
ADMIN_SECRET=change_me_to_a_long_random_string

# ---- Game config (admin-overridable at runtime via /api/admin/config) ----
GAME_DURATION_SECONDS=900
MAX_RECOVERIES=3
INITIAL_LIVES=5
RECOVERY_WINDOW_SECONDS=30

# ---- Optional AI ----
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_JSON_MODE=

# ---- Test / demo mode ----
# Never enable this on the public event build.
DEMO_MODE_ENABLED=false
DEMO_MODE_SECRET=
