# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Supabase (backend — never expose to frontend) ----
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Database (Supabase PostgreSQL — Transaction Pooler URI) ----
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ---- Admin (unchanged) ----
ADMIN_SECRET=change_me_admin_password

# ---- Game config (admin-overridable at runtime via /api/admin/config) ----
GAME_DURATION_SECONDS=900
MAX_RECOVERIES=3
INITIAL_LIVES=5
RECOVERY_WINDOW_SECONDS=30

# ---- Optional AI ----
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=
AI_JSON_MODE=true

# ---- Test / demo mode ----
# Never enable this on the public event build.
DEMO_MODE_ENABLED=true
DEMO_MODE_SECRET=change_me_demo_password
